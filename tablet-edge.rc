#include <windows.h>
#include "resource.h"

// The first icon resource also becomes the exe's icon in Explorer.
IDI_APP ICON "icon.ico"

// Common Controls v6 (modern control styling) and per-monitor DPI awareness.
1 RT_MANIFEST "tablet-edge.manifest"

IDD_MONITOR DIALOGEX 0, 0, 420, 260
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME |
      WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Tablet Edge"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_STATUS, 7, 7, 406, 10, SS_ENDELLIPSIS
    PUSHBUTTON      "Take over tablet", IDC_TOGGLE, 7, 21, 80, 14
    PUSHBUTTON      "Settings...", IDC_SETTINGS, 91, 21, 60, 14
    PUSHBUTTON      "Open log file", IDC_OPENLOG, 155, 21, 60, 14
    PUSHBUTTON      "Clear", IDC_CLEAR, 219, 21, 50, 14
    EDITTEXT        IDC_LOG, 7, 40, 406, 213, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL |
                    ES_AUTOHSCROLL | ES_NOHIDESEL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
END

IDD_SETTINGS DIALOGEX 0, 0, 300, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tablet Edge Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Trigger edge", -1, 7, 7, 286, 74
    LTEXT           "Edge of the desktop:", -1, 15, 21, 92, 8
    COMBOBOX        IDC_SIDE, 112, 19, 80, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Push threshold:", -1, 15, 38, 92, 8
    EDITTEXT        IDC_THRESHOLD, 112, 36, 50, 12, ES_NUMBER
    LTEXT           "raw mouse counts", -1, 168, 38, 110, 8
    LTEXT           "Push window:", -1, 15, 52, 92, 8
    EDITTEXT        IDC_TIMEOUT, 112, 50, 50, 12, ES_NUMBER
    LTEXT           "ms", -1, 168, 52, 110, 8
    LTEXT           "Corner dead zone:", -1, 15, 66, 92, 8
    EDITTEXT        IDC_MARGIN, 112, 64, 50, 12, ES_NUMBER
    LTEXT           "px at each end", -1, 168, 66, 110, 8

    GROUPBOX        "Tablet", -1, 7, 86, 286, 54
    LTEXT           "USB serial (empty = any):", -1, 15, 100, 92, 8
    EDITTEXT        IDC_SERIAL, 112, 98, 100, 12, ES_AUTOHSCROLL
    LTEXT           "scrcpy.exe:", -1, 15, 118, 92, 8
    EDITTEXT        IDC_SCRCPY, 112, 116, 122, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE, 238, 115, 48, 14

    DEFPUSHBUTTON   "OK", IDOK, 187, 149, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 149, 50, 14
END
